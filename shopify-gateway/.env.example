# Shopify App credentials (from the Shopify Partner dashboard — same values for all tenants)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# A strong random secret shared with every CoopCycle tenant.
# Each tenant sets SHOPIFY_GATEWAY_SECRET to this same value.
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=

# The public URL where this gateway is deployed (no trailing slash).
# Must match the App URL and Redirect URI registered in the Shopify Partner dashboard.
APP_URL=https://connect.coopcycle.org

# Comma-separated list of CoopCycle tenants shown in the install dropdown.
# Format: "Display+Name:https://tenant-url.org" (spaces in names encoded as +)
# If empty, falls back to a free-text URL field.
# TENANTS="Paris:https://paris.coopcycle.org,Name+with+spaces:https://name-with-spaces.coopcycle.org"

# UUID of the "CoopCycle Cart Date Picker" theme app extension, used to deep-link
# the block into a merchant's cart template from the post-install page.
# Read it from .shopify/deploy-bundle/manifest.json (the theme_app_extension
# module's "uuid") after `shopify app deploy`. Only needed when running your own
# Shopify app; otherwise the published app's UUID is used.
# THEME_EXTENSION_UUID=
