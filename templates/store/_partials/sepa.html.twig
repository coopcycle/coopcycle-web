<div class="form-group">
  <label>{{ 'store.sepa.mandate_status.label'|trans }}</label>
  <p>
    {% set mandate_status = store.sepaMandateStatus ?? 'none' %}
    <span class="label label-{{ mandate_status == 'active' ? 'success' : (mandate_status == 'failed' ? 'danger' : 'default') }}">
      {{ ('store.sepa.mandate_status.' ~ mandate_status)|trans }}
    </span>
  </p>
  <span class="help-block">{{ 'store.sepa.mandate_status.help'|trans }}</span>
</div>

<div class="form-group" data-widget="sepa-setup" data-endpoint="{{ path('admin_store_sepa_setup', { id: store.id }) }}">
  <button type="button" class="btn btn-default" data-role="sepa-setup-trigger">
    {{ 'store.sepa.send_setup_link'|trans }}
  </button>
  <span class="help-block">{{ 'store.sepa.send_setup_link.help'|trans }}</span>
</div>
