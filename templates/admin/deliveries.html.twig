{% extends "deliveries.html.twig" %}

{% block prepare_title %}
  {{ add_title_prefix('adminDashboard.deliveries.title'|trans) }}
{% endblock %}

{% form_theme import_form 'bootstrap_3_horizontal_layout.html.twig' %}
{% if is_granted('ROLE_ADMIN') %}
{% form_theme delivery_export_form 'form/deliveries_export.html.twig' %}
{% endif %}

{% block content %}

  <div class="d-flex justify-content-between mb-5">
    <form class="w-50" method="get">
      <input type="text" class="form-control" placeholder="{{ 'stores.filters.input.placeholder'|trans|e('html_attr') }}" name="q" value="{{ filters.query }}">
    </form>
    <div class="text-right">
      <a href="#" class="btn btn-sm btn-default mr-4" data-toggle="modal" data-target="#import-modal">
        <i class="fa fa-upload"></i> {% trans %}basics.import{% endtrans %}
      </a>
      {% if is_granted('ROLE_ADMIN') %}
      <a href="#" class="btn btn-sm btn-default mr-4" data-toggle="modal" data-target="#export-deliveries-modal">
        <i class="fa fa-download"></i> {% trans %}basics.export{% endtrans %}
      </a>
      {% endif %}
      {% include '_partials/delivery/create_new_button.html.twig' %}
    </div>
  </div>

  {% if import_form.vars.submitted and not import_form.vars.valid %}
    <div class="alert alert-danger">
      <ul class="list-unstyled">
      {% for error in import_form.vars.errors %}
        <li>{{ error.message }}</li>
      {% endfor %}
      {% for child in import_form.children %}
        {% for error in child.vars.errors %}
          <li>{{ error.message }}</li>
        {% endfor %}
      {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if delivery_export_form.vars.submitted and not delivery_export_form.vars.valid %}
    {{ form_errors(delivery_export_form) }}
  {% endif %}

  {% set tab_items = [
    {
      title: 'basics.today'|trans,
      active: ((deliveries.params.section is not defined) or (deliveries.params.section == 'today')),
      path: path('admin_deliveries')
    },
    {
      title: 'deliveries.section.upcoming'|trans,
      active: (deliveries.params.section is defined and deliveries.params.section == 'upcoming'),
      path: path('admin_deliveries', { section: 'upcoming' })
    },
    {
      title: 'deliveries.section.past'|trans,
      active: (deliveries.params.section is defined and deliveries.params.section == 'past'),
      path: path('admin_deliveries', { section: 'past' })
    },
    {
      title: 'imports.title'|trans,
      active: app.request.query.get('section', 'today') == 'imports',
      path: path('admin_deliveries', { section: 'imports' })
    },
  ] %}

  <ul class="nav nav-tabs">
    {% if filters is defined and filters.query %}
    <p><i class="fa fa-search" aria-hidden="true"></i> {% trans with { '%query%': filters.query } %}stores.search.results_for{% endtrans %}</p>
    {% endif %}
    {% if filters is defined and filters.range %}
    <p><i class="fa fa-calendar" aria-hidden="true"></i> {{filters.range[0]|date("m/d/Y")}} <i class="fa fa-long-arrow-right" aria-hidden="true"></i>  {{filters.range[1]|date("m/d/Y")}}</p>
    {% endif %}
    {% if filters is defined and filters.query == null and filters.range == null %}
    {% for tab_item in tab_items %}
    <li role="presentation" class="{% if tab_item.active %}active{% endif %}">
      <a href="{{ tab_item.path }}" data-testid="tab:{{ tab_item.path }}">
        {{ tab_item.title }}
      </a>
    </li>
    {% endfor %}
    {% endif %}
  </ul>

  {% if app.request.query.get('section', 'today') != 'imports' %}
  <div class="d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center mt-4 mb-3">
      <div class="dropdown d-inline-block mr-4">
        {% include '_partials/delivery/sort.html.twig' %}
      </div>
      {# Filter is active #}
      {% if filters.owner %}
        {% set params_without_filters = deliveries.params|filter((value, key) => key not in [ 'store', 'restaurant', 'page' ]) %}
        <a class="btn btn-sm btn-default mr-4" href="{{ path(deliveries.route, params_without_filters) }}" data-testid="deliveries__clear_filter">
          {{ 'deliveries.filter.clear'|trans }} <i class="fa fa-times"></i>
        </a>
      {% endif %}
    </div>
    <div class="text-monospace">
    {{ knp_pagination_render(deliveries, '@KnpPaginator/Pagination/sliding.html.twig') }}
    </div>
  </div>
  {% endif %}

  {% if app.request.query.get('section', 'today') == 'imports' %}
    {# The items_ ones once the import is over and what it created was cancelled by a dispatcher: nothing from the file is left either #}
    {# Duplicated in js/app/delivery/list.js, which renders the rows as they change #}
    {% set import_type_icon = {
      'deliveries': 'cube',
      'tasks': 'map-marker'
    } %}
    {% set import_status_icon = {
      'mapping': 'hand-pointer-o',
      'pending': 'clock-o',
      'started': 'play',
      'saving': 'floppy-o',
      'completed': 'check',
      'failed': 'exclamation-triangle',
      'cancelled': 'ban',
      'items_cancelling': 'spinner fa-spin',
      'items_cancelled': 'ban'
    } %}
    <div class="text-right my-2">
      <div id="import-datepicker" data-default-date="{{ import_date|date('Y-m-d') }}"></div>
    </div>
    <table class="table mb-4"
      data-imports
      data-centrifugo-token="{{ centrifugo_token }}"
      data-centrifugo-channel="{{ centrifugo_channel }}">
      <thead>
        <th></th>
        <th></th>
        <th>{{ 'form.delivery_import.file.label'|trans }}</th>
        <th>{{ 'imports.created_at'|trans }}</th>
        <th>{{ 'imports.progress'|trans }}</th>
        <th></th>
      </thead>
      <tbody>
        {% for import_queue in import_queues %}
          <tr class="{{ import_queue.status == 'failed' ? 'danger' : '' }}"
            data-import
            data-import-filename="{{ import_queue.filename }}"
            data-import-queue="{{ path('_api_/import_queues/{id}{._format}_get', { id: import_queue.id }) }}"
            data-import-csv="{{ path('_api_/import_queues/{id}/csv_get', { id: import_queue.id }) }}"
            data-import-redownload="{{ path('_api_/import_queues/{id}/redownload_get', { id: import_queue.id }) }}"
            data-import-cancel="{{ path('_api_/import_queues/{id}/cancel_put', { id: import_queue.id }) }}"
            data-import-cancel-items="{{ path('_api_/import_queues/{id}/cancel_items_put', { id: import_queue.id }) }}"
            data-import-type="{{ import_queue.type }}"
            data-import-created="{{ imported_items[import_queue.id] ?? 0 }}">
            <td width="5%">
              <i class="fa fa-{{ import_type_icon[import_queue.type] }}" data-toggle="tooltip"
                title="{{ ('imports.type.' ~ import_queue.type)|trans }}"></i>
            </td>
            <td width="5%"><i class="fa fa-{{ import_status_icon[import_queue.itemsCancellation ? 'items_' ~ import_queue.itemsCancellation : import_queue.status] }}" data-import-status></i></td>
            <td>
              {{ import_queue.filename }}
              {% if import_queue.options.date is defined %}
                {# The list is filed by the day the file was uploaded, which is not
                   necessarily the day its tasks are for #}
                <span class="text-muted small ml-2">{{ 'imports.for_date'|trans({ '%date%': import_queue.options.date|date('d/m/Y') }) }}</span>
              {% endif %}
            </td>
            <td>{{ import_queue.createdAt|time_diff }}</td>
            {# Formatted by list.js, which also keeps it up to date while the file is imported #}
            <td class="text-muted"
              data-import-progress
              data-status="{{ import_queue.status }}"
              data-started-at="{{ import_queue.startedAt ? import_queue.startedAt|date('c') : '' }}"
              data-total-rows="{{ import_queue.totalRows }}"
              data-processed-rows="{{ import_queue.processedRows }}"
              data-error-rows="{{ import_queue.errorRows }}"
              data-items-cancellation="{{ import_queue.itemsCancellation }}"
              data-items-to-cancel="{{ import_queue.itemsToCancel }}"
              data-cancelled-items="{{ import_queue.cancelledItems }}"
              data-skipped-items="{{ import_queue.skippedItems }}"></td>
            <td class="text-right">
              <a href="#" class="mr-3 text-danger{{ import_queue.cancellable ? '' : ' d-none' }}" data-import-cancel-button>
                <i class="fa fa-ban"></i> {{ 'imports.cancel'|trans }}
              </a>
              {# Hidden by list.js once they are being cancelled #}
              <a href="#" class="mr-3 text-danger{{ import_queue.canCancelItems and (imported_items[import_queue.id] ?? 0) > 0 ? '' : ' d-none' }}" data-import-cancel-items-button>
                <i class="fa fa-ban"></i> {{ ('imports.cancel_' ~ import_queue.type)|trans }}
              </a>
              {% if import_queue.waitingForMapping %}
                {# Nothing of the file has been read yet: there is no spreadsheet to show,
                   only the columns left to map #}
                <a class="mr-3 text-underline" href="{{ path('admin_import_mapping', { id: import_queue.id }) }}">
                  {{ 'imports.continue_mapping'|trans }}
                </a>
              {% elseif import_queue.status == 'failed' %}
                <a href="#" class="mr-3 text-danger text-underline" data-import-view>
                  {{ 'imports.see_errored_file'|trans }}
                </a>
              {% else %}
                {# Switched to the errors by list.js, when the import fails while the page is open #}
                <a href="#" class="mr-3 text-underline" data-import-view
                  data-errors-label="{{ 'imports.see_errored_file'|trans }}">
                  {{ 'imports.see_file'|trans }}
                </a>
              {% endif %}
              {% if not import_queue.waitingForMapping %}
                <a href="#" data-import-redownload>
                  <i class="fa fa-download"></i>
                </a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <div id="import_spreadsheet"></div>
  {% else %}
    {% include '_partials/delivery/list.html.twig' with { with_store: true } %}
    <nav class="text-center">
      {{ knp_pagination_render(deliveries) }}
    </nav>
  {% endif %}



  {# One modal for both kinds: the fields and the example file of the kind that isn't
     chosen are hidden by import-modal.js #}
  <div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="import-modal-label" id="import-modal">
    <div class="modal-dialog" role="document">
      {{ form_start(import_form, { attr: { class: 'modal-content' } }) }}
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title" id="import-modal-label">{% trans %}basics.import{% endtrans %}</h4>
        </div>
        <div class="modal-body">
          {{ form_row(import_form.type) }}
          {{ form_row(import_form.store) }}
          {{ form_row(import_form.date) }}
          {{ form_row(import_form.file) }}
        </div>
        <div class="modal-footer">
          <a class="mr-4" href="{{ path('spreadsheet_example_deliveries') }}" data-import-kind-link="deliveries">{{ 'spreadsheet.download_example'|trans }}</a>
          <a class="mr-4" href="{{ path('spreadsheet_example_tasks') }}" data-import-kind-link="tasks">{{ 'spreadsheet.download_example'|trans }}</a>
          <button type="button" class="btn btn-default" data-dismiss="modal">{% trans %}basics.cancel{% endtrans %}</button>
          <button type="submit" class="btn btn-primary" data-testid="import-submit">{% trans %}basics.import{% endtrans %}</button>
        </div>
      {{ form_end(import_form) }}
    </div>
  </div>

  <div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="export-deliveries-modal-label" id="export-deliveries-modal">
    <div class="modal-dialog" role="document">
      {{ form_start(delivery_export_form, { attr: { class: 'modal-content' } }) }}
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title" id="export-deliveries-modal-label">{% trans %}basics.export{% endtrans %}</h4>
        </div>
        <div class="modal-body">
          {{ form_widget(delivery_export_form) }}
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">{% trans %}basics.cancel{% endtrans %}</button>
          <button type="submit" class="btn btn-primary">{% trans %}basics.export{% endtrans %}</button>
        </div>
      {{ form_end(delivery_export_form) }}
    </div>
  </div>

{% endblock %}

{% block styles %}
  {{ encore_entry_link_tags('delivery-list') }}
{% endblock %}

{% block scripts %}
{{ encore_entry_script_tags('delivery-list') }}
{% endblock %}
