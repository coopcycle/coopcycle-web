{% extends "admin.html.twig" %}
{% import '_partials/referral/_level_icon.html.twig' as referral_icons %}

{% block prepare_title %}
  {{ add_title_prefix('referral.title'|trans) }}
{% endblock %}

{% block breadcrumb %}
<li><a href="{{ path('admin_referral_program') }}">{% trans %}referral.title{% endtrans %}</a></li>
{% endblock %}

{% block styles %}
  {{ encore_entry_link_tags('admin-referral-program') }}
{% endblock %}

{% block content %}

{% form_theme active_form 'bootstrap_3_layout.html.twig' %}
<div class="panel panel-default" style="margin-bottom:16px;">
  <div class="panel-body">
    {{ form_start(active_form, { attr: { id: 'referral-program-active-form' } }) }}
      <div class="d-flex align-items-center" style="gap:8px;">
        {{ form_widget(active_form.active) }}
        <strong>{% trans %}referral.program.active_label{% endtrans %}</strong>
      </div>
      <p class="text-muted" style="margin:4px 0 0;">{% trans %}referral.program.active_help{% endtrans %}</p>
    {{ form_end(active_form) }}
  </div>
</div>

{% if not is_active %}
<div class="alert alert-warning" role="alert">
  <i class="fa fa-exclamation-triangle"></i> {% trans %}referral.program.inactive_warning{% endtrans %}
</div>
{% endif %}

<div class="row" style="margin-bottom:16px;">
  <div class="col-md-3">
    <div class="panel panel-default">
      <div class="panel-body text-center">
        <h3 style="margin:0;">{{ status_counts.pending + status_counts.completed + status_counts.expired }}</h3>
        <p class="text-muted" style="margin:0;">{% trans %}referral.stats.total{% endtrans %}</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="panel panel-default">
      <div class="panel-body text-center">
        <h3 style="margin:0;">{{ status_counts.pending }}</h3>
        <p class="text-muted" style="margin:0;">{% trans %}referral.stats.pending{% endtrans %}</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="panel panel-default">
      <div class="panel-body text-center">
        <h3 style="margin:0;">{{ status_counts.completed }}</h3>
        <p class="text-muted" style="margin:0;">{% trans %}referral.stats.completed{% endtrans %}</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="panel panel-default">
      <div class="panel-body text-center">
        <h3 style="margin:0;">{{ conversion_rate is not null ? (conversion_rate * 100)|number_format(0) ~ '%' : 'N/A' }}</h3>
        <p class="text-muted" style="margin:0;">{% trans %}referral.stats.conversion_rate{% endtrans %}</p>
      </div>
    </div>
  </div>
</div>

{% if level_breakdown is not empty %}
<div class="row" style="margin-bottom:16px;">
  {% for name, count in level_breakdown %}
  <div class="col-md-{{ 12 // level_breakdown|length }}">
    <div class="panel panel-info">
      <div class="panel-body text-center">
        <h4 style="margin:0;">{{ count }}</h4>
        <p class="text-muted" style="margin:0;">{{ referral_icons.icon(name) }} {{ ('referral.level.' ~ name)|trans({}, 'emails') }}</p>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

{% form_theme levels_form 'bootstrap_3_layout.html.twig' %}
<div class="panel panel-default">
  <div class="panel-heading" style="cursor:pointer;" data-toggle="collapse" data-target="#referral-levels-panel">
    <i class="fa fa-sliders"></i> {% trans %}referral.levels.configure{% endtrans %}
    <span class="pull-right"><i class="fa fa-chevron-down"></i></span>
  </div>
  <div id="referral-levels-panel" class="panel-collapse collapse">
    <div class="panel-body">
      <div class="alert alert-info" role="alert">
        <h4><i class="fa fa-info-circle"></i> {% trans %}referral.levels.info.title{% endtrans %}</h4>
        <p style="margin:0;">{% trans %}referral.levels.info.body{% endtrans %}</p>
      </div>
      {{ form_start(levels_form) }}
      <div class="row">
        {% for level in levels %}
        <div class="col-md-{{ 12 // levels|length }}">
          <h5>{{ referral_icons.icon(level.name) }} {{ ('referral.level.' ~ level.name)|trans({}, 'emails') }}</h5>
          {{ form_widget(levels_form['level_' ~ level.id]) }}
        </div>
        {% endfor %}
      </div>
      <button type="submit" class="btn btn-primary">{% trans %}basics.save{% endtrans %}</button>
      {{ form_end(levels_form) }}
    </div>
  </div>
</div>

{% form_theme welcome_settings_form 'bootstrap_3_layout.html.twig' %}
<div class="panel panel-default">
  <div class="panel-heading" style="cursor:pointer;" data-toggle="collapse" data-target="#referral-welcome-settings-panel">
    <i class="fa fa-gift"></i> {% trans %}referral.welcome_settings.configure{% endtrans %}
    <span class="pull-right"><i class="fa fa-chevron-down"></i></span>
  </div>
  <div id="referral-welcome-settings-panel" class="panel-collapse collapse">
    <div class="panel-body">
      <div class="alert alert-info" role="alert">
        <h4><i class="fa fa-info-circle"></i> {% trans %}referral.welcome_settings.info.title{% endtrans %}</h4>
        <p style="margin:0;">{% trans %}referral.welcome_settings.info.body{% endtrans %}</p>
      </div>
      {{ form(welcome_settings_form) }}
    </div>
  </div>
</div>

<hr>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
  <div class="btn-group">
    <a href="{{ path('admin_referral_program') }}" class="btn btn-sm {{ active_status is null ? 'btn-primary' : 'btn-default' }}">{% trans %}referral.filter.all{% endtrans %}</a>
    <a href="{{ path('admin_referral_program', { status: 'pending' }) }}" class="btn btn-sm {{ active_status == 'pending' ? 'btn-primary' : 'btn-default' }}">{% trans %}referral.status.pending{% endtrans %}</a>
    <a href="{{ path('admin_referral_program', { status: 'completed' }) }}" class="btn btn-sm {{ active_status == 'completed' ? 'btn-primary' : 'btn-default' }}">{% trans %}referral.status.completed{% endtrans %}</a>
    <a href="{{ path('admin_referral_program', { status: 'expired' }) }}" class="btn btn-sm {{ active_status == 'expired' ? 'btn-primary' : 'btn-default' }}">{% trans %}referral.status.expired{% endtrans %}</a>
  </div>
</div>

{% if referrals.totalItemCount > 0 %}
<table class="table">
  <thead>
    <tr>
      <th>{% trans %}referral.column.referrer{% endtrans %}</th>
      <th>{% trans %}referral.column.referred{% endtrans %}</th>
      <th>{% trans %}referral.column.status{% endtrans %}</th>
      <th class="text-right">{% trans %}referral.column.created_at{% endtrans %}</th>
      <th class="text-right">{% trans %}referral.column.completed_at{% endtrans %}</th>
    </tr>
  </thead>
  <tbody>
    {% for referral in referrals %}
    <tr>
      <td><span class="text-monospace">{{ referral.referrer.email }}</span></td>
      <td><span class="text-monospace">{{ referral.referred.email }}</span></td>
      <td>
        <span class="label label-{{ referral.status == 'completed' ? 'success' : (referral.status == 'expired' ? 'default' : 'info') }}">
          {{ ('referral.status.' ~ referral.status)|trans }}
        </span>
      </td>
      <td class="text-right">{{ referral.createdAt|ago }}</td>
      <td class="text-right">{{ referral.completedAt ? referral.completedAt|ago : '-' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<nav class="text-center">
  {{ knp_pagination_render(referrals) }}
</nav>
{% else %}
<div class="alert alert-info">{% trans %}referral.no_referrals{% endtrans %}</div>
{% endif %}

{% endblock %}

{% block scripts %}
  {{ encore_entry_script_tags('admin-referral-program') }}
<script>
  (function () {
    // Toggles the sibling "amount" / "percentage" field based on the
    // reward type <select>, for both the per-level forms (camelCase field
    // names: ..._rewardType/_rewardAmount/_rewardPercentage) and the global
    // welcome coupon form (snake_case: ..._reward_type/_reward_amount/_reward_percentage).
    function fieldGroup(id) {
      var el = document.getElementById(id);
      return el ? el.closest('.form-group') : null;
    }

    function toggle(select) {
      var id = select.id;
      var base, amountSuffix, percentageSuffix;

      if (id.endsWith('rewardType')) {
        base = id.slice(0, -('rewardType'.length));
        amountSuffix = 'rewardAmount';
        percentageSuffix = 'rewardPercentage';
      } else if (id.endsWith('reward_type')) {
        base = id.slice(0, -('reward_type'.length));
        amountSuffix = 'reward_amount';
        percentageSuffix = 'reward_percentage';
      } else {
        return;
      }

      var isPercentage = select.value === 'order_percentage_discount';
      var amountGroup = fieldGroup(base + amountSuffix);
      var percentageGroup = fieldGroup(base + percentageSuffix);

      if (amountGroup) {
        amountGroup.style.display = isPercentage ? 'none' : '';
      }
      if (percentageGroup) {
        percentageGroup.style.display = isPercentage ? '' : 'none';
      }
    }

    document.querySelectorAll('select[id$="rewardType"], select[id$="reward_type"]').forEach(function (select) {
      toggle(select);
      select.addEventListener('change', function () {
        toggle(select);
      });
    });
  })();
</script>
{% endblock %}
