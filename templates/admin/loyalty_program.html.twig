{% extends "admin.html.twig" %}

{% block prepare_title %}
  {{ add_title_prefix('loyalty.title'|trans) }}
{% endblock %}

{% block breadcrumb %}
<li><a href="{{ path('admin_loyalty_program') }}">{% trans %}loyalty.title{% endtrans %}</a></li>
{% endblock %}

{% block styles %}
  {{ encore_entry_link_tags('admin-loyalty-program') }}
{% endblock %}

{% block content %}

{% form_theme active_form 'bootstrap_3_layout.html.twig' %}
<div class="panel panel-default" style="margin-bottom:16px;">
  <div class="panel-body">
    {{ form_start(active_form, { attr: { id: 'loyalty-program-active-form' } }) }}
      <div class="d-flex align-items-center" style="gap:8px;">
        {{ form_widget(active_form.active) }}
        <strong>{% trans %}loyalty.program.active_label{% endtrans %}</strong>
      </div>
      <p class="text-muted" style="margin:4px 0 0;">{% trans %}loyalty.program.active_help{% endtrans %}</p>
    {{ form_end(active_form) }}
  </div>
</div>

{% if not is_active %}
<div class="alert alert-warning" role="alert">
  <i class="fa fa-exclamation-triangle"></i> {% trans %}loyalty.program.inactive_warning{% endtrans %}
</div>
{% endif %}

{% form_theme settings_form 'bootstrap_3_layout.html.twig' %}
<div class="panel panel-default">
  <div class="panel-heading" style="cursor:pointer;" data-toggle="collapse" data-target="#loyalty-settings-panel">
    <i class="fa fa-sliders"></i> {% trans %}loyalty.settings.configure{% endtrans %}
    <span class="pull-right"><i class="fa fa-chevron-down"></i></span>
  </div>
  <div id="loyalty-settings-panel" class="panel-collapse collapse in">
    <div class="panel-body">
      <div class="alert alert-info" role="alert">
        <h4><i class="fa fa-info-circle"></i> {% trans %}loyalty.settings.info.title{% endtrans %}</h4>
        <p style="margin:0;">{% trans %}loyalty.settings.info.body{% endtrans %}</p>
      </div>
      {{ form_start(settings_form) }}
        {{ form_widget(settings_form) }}
        <button type="submit" class="btn btn-primary">{% trans %}basics.save{% endtrans %}</button>
      {{ form_end(settings_form) }}
    </div>
  </div>
</div>

{% form_theme rewards_form 'bootstrap_3_layout.html.twig' %}
<div class="panel panel-default">
  <div class="panel-heading" style="cursor:pointer;" data-toggle="collapse" data-target="#loyalty-rewards-panel">
    <i class="fa fa-gift"></i> {% trans %}loyalty.rewards.configure{% endtrans %}
    <span class="pull-right"><i class="fa fa-chevron-down"></i></span>
  </div>
  <div id="loyalty-rewards-panel" class="panel-collapse collapse in">
    <div class="panel-body">
      <div class="alert alert-info" role="alert">
        <h4><i class="fa fa-info-circle"></i> {% trans %}loyalty.rewards.info.title{% endtrans %}</h4>
        <p style="margin:0;">{% trans %}loyalty.rewards.info.body{% endtrans %}</p>
      </div>

      {{ form_start(rewards_form) }}
        <div id="loyalty-rewards-list" data-prototype="{{ form_widget(rewards_form.rewards.vars.prototype)|e('html_attr') }}">
          {% for reward in rewards_form.rewards %}
            <div class="loyalty-reward-entry panel panel-default">
              <div class="panel-body">
                {{ form_widget(reward) }}
                <button type="button" class="btn btn-sm btn-danger delete-reward-entry">
                  <i class="fa fa-trash"></i> {% trans %}basics.delete{% endtrans %}
                </button>
              </div>
            </div>
          {% endfor %}
        </div>

        <button type="button" id="loyalty-rewards-add" class="btn btn-default">
          <i class="fa fa-plus"></i> {% trans %}loyalty.rewards.add{% endtrans %}
        </button>
        <button type="submit" class="btn btn-primary">{% trans %}basics.save{% endtrans %}</button>
      {{ form_end(rewards_form) }}
    </div>
  </div>
</div>

<hr>

<h4>{% trans %}loyalty.activity.title{% endtrans %}</h4>
<p class="text-muted">{% trans %}loyalty.activity.help{% endtrans %}</p>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
  <div class="btn-group">
    <a href="{{ path('admin_loyalty_program') }}" class="btn btn-sm {{ active_type is null ? 'btn-primary' : 'btn-default' }}">{% trans %}loyalty.filter.all{% endtrans %}</a>
    <a href="{{ path('admin_loyalty_program', { type: 'credit' }) }}" class="btn btn-sm {{ active_type == 'credit' ? 'btn-primary' : 'btn-default' }}">{% trans %}loyalty.type.credit{% endtrans %}</a>
    <a href="{{ path('admin_loyalty_program', { type: 'debit' }) }}" class="btn btn-sm {{ active_type == 'debit' ? 'btn-primary' : 'btn-default' }}">{% trans %}loyalty.type.debit{% endtrans %}</a>
    <a href="{{ path('admin_loyalty_program', { type: 'expiry' }) }}" class="btn btn-sm {{ active_type == 'expiry' ? 'btn-primary' : 'btn-default' }}">{% trans %}loyalty.type.expiry{% endtrans %}</a>
  </div>
</div>

{% if activity.totalItemCount > 0 %}
<table class="table">
  <thead>
    <tr>
      <th>{% trans %}loyalty.activity.column.customer{% endtrans %}</th>
      <th>{% trans %}loyalty.activity.column.description{% endtrans %}</th>
      <th class="text-right">{% trans %}loyalty.activity.column.points{% endtrans %}</th>
      <th class="text-right">{% trans %}loyalty.activity.column.remaining{% endtrans %}</th>
      <th class="text-right">{% trans %}loyalty.activity.column.expires_at{% endtrans %}</th>
      <th class="text-right">{% trans %}referral.column.created_at{% endtrans %}</th>
    </tr>
  </thead>
  <tbody>
    {% for entry in activity %}
    <tr>
      <td>
        <a href="{{ path('admin_customer', { id: entry.customer.id }) }}">
          <span class="text-monospace">{{ entry.customer.email }}</span>
        </a>
      </td>
      <td>
        {% if entry.isCredit %}
          <span class="label label-success">{% trans %}loyalty.type.credit{% endtrans %}</span>
          {% if entry.order %}
            <a href="{{ path('admin_order', { id: entry.order.id }) }}">#{{ entry.order.number }}</a>
          {% endif %}
        {% elseif entry.isExpiry %}
          <span class="label label-default">{% trans %}loyalty.type.expiry{% endtrans %}</span>
        {% else %}
          <span class="label label-info">{% trans %}loyalty.type.debit{% endtrans %}</span>
          {{ entry.reward ? entry.reward.name : '' }}
          {% if entry.coupon %}
            <span class="label label-default">{{ entry.coupon.code }}</span>
          {% endif %}
        {% endif %}
      </td>
      <td class="text-right {{ entry.isCredit ? 'text-success' : '' }}">
        {{ entry.amount > 0 ? '+' : '' }}{{ entry.amount }}
      </td>
      {# Only credits carry a remaining balance; on the other lines it would
         read as a zero that means something. #}
      <td class="text-right">{{ entry.isCredit ? entry.remaining : '-' }}</td>
      <td class="text-right">{{ entry.expiresAt ? entry.expiresAt|format_date('short') : '-' }}</td>
      <td class="text-right">{{ entry.createdAt|ago }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<nav class="text-center">
  {{ knp_pagination_render(activity) }}
</nav>
{% else %}
<div class="alert alert-info">{% trans %}loyalty.activity.none{% endtrans %}</div>
{% endif %}

{% endblock %}

{% block scripts %}
  {{ encore_entry_script_tags('admin-loyalty-program') }}
{% endblock %}
