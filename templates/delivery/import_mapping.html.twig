{% extends layout %}

{% form_theme form 'bootstrap_3_layout.html.twig' %}

{% block breadcrumb %}
  <li><a href="{{ cancel_url }}">{% trans %}adminDashboard.deliveries.title{% endtrans %}</a></li>
  <li>{{ 'import.mapping.title'|trans }}</li>
{% endblock %}

{% block content %}

  <h4 class="mb-2">{{ 'import.mapping.title'|trans }}</h4>
  <p class="text-muted">{{ 'import.mapping.help'|trans({ '%filename%': import_queue.filename }) }}</p>

  {{ form_start(form, { attr: { 'data-column-mapping': 'true' } }) }}

    {% if not form.vars.valid %}
      <div class="alert alert-danger">{{ form_errors(form) }}</div>
    {% endif %}

    {# The file as it is, one column per column, so the dispatcher reads the mapping
       against the values it applies to rather than against a sample of them. #}
    <div class="table-responsive" data-column-mapping-table>
      <table class="table table-condensed table-bordered">
        <thead>
          <tr>
            <th class="text-muted small">{{ 'import.mapping.column_in_file'|trans }}</th>
            {% for index in preview.columnIndexes %}
              <th>
                <label class="control-label" for="{{ form[index].vars.id }}">{{ form[index].vars.label }}</label>
              </th>
            {% endfor %}
          </tr>
          <tr>
            <th class="text-muted small">{{ 'import.mapping.maps_to'|trans }}</th>
            {% for index in preview.columnIndexes %}
              {% set child = form[index] %}
              <th>
                {{ form_widget(child, { attr: child.vars.attr|merge({ class: 'form-control input-sm' }) }) }}
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in preview.rows %}
            <tr>
              {# The header is row 1 of the file, so the first data row is row 2. #}
              <td class="text-muted small text-nowrap">{{ 'import.mapping.row'|trans({ '%number%': loop.index + 1 }) }}</td>
              {% for index in preview.columnIndexes %}
                <td class="small">{{ (row[index] ?? '')|trim|u.truncate(60, '…') }}</td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="text-right mb-4">
      <button type="submit" class="btn btn-primary">{% trans %}basics.import{% endtrans %}</button>
    </div>

  {{ form_end(form) }}

  {# Discards the file. A form of its own, outside the mapping one: it has to work
     whether or not the columns are all matched yet, and nothing of the file has been
     read, so there is nothing to undo. #}
  <form method="post" class="text-right mb-4" data-column-mapping-cancel>
    <input type="hidden" name="_token" value="{{ csrf_token(cancel_token_id) }}">
    <button type="submit" name="cancel_import" value="1" class="btn btn-link text-danger">
      <i class="fa fa-trash-o"></i> {{ 'deliveries.imports.drop_file'|trans }}
    </button>
  </form>

{% endblock %}

{% block styles %}
  {{ encore_entry_link_tags('delivery-import-mapping') }}
{% endblock %}

{% block scripts %}
  {{ encore_entry_script_tags('delivery-import-mapping') }}
{% endblock %}
