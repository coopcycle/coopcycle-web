{% extends "frontend.html.twig" %}

{% block body %}
<div class="min-h-[60vh] flex items-center justify-center py-12 px-4">
  <div class="card w-full max-w-md bg-base-100 shadow-xl">
    <div class="card-body">

      {% if authenticationError is defined and authenticationError %}
      <div class="alert alert-error mb-4">
        <span>{{ attribute(authenticationError, 'messageKey') is defined
          ? authenticationError.messageKey | trans(authenticationError.messageData ?? {}, 'SchebTwoFactorBundle')
          : authenticationError | trans({}, 'SchebTwoFactorBundle') }}</span>
      </div>
      {% endif %}

      <h2 class="card-title justify-center text-2xl">{{ 'two_factor.title' | trans({}, 'messages') }}</h2>
      <p class="text-center text-base-content/60">
        {{ 'two_factor.subtitle' | trans({}, 'messages') }}
      </p>

      <form id="two-factor-form" method="post" action="{{ path('2fa_login_check') }}"
            {{ stimulus_controller('otp-input') }}
            data-action="submit->otp-input#onSubmit">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('two_factor') }}" />
        <input type="hidden" name="_auth_code" {{ stimulus_target('otp-input', 'hidden') }} />

        <div class="flex gap-3 justify-center my-6">
          {% for i in 1..6 %}
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off"
            {{ stimulus_target('otp-input', 'digit') }}
            data-action="input->otp-input#onInput keydown->otp-input#onKeydown paste->otp-input#onPaste"
            class="input input-bordered w-12 h-14 text-2xl text-center px-0 caret-transparent" />
          {% endfor %}
        </div>

        <button {{ stimulus_target('otp-input', 'submit') }}
          class="btn btn-primary btn-block btn-lg" type="submit">
          <span class="submit-text">{{ 'two_factor.submit' | trans({}, 'messages') }}</span>
          <span class="loading loading-spinner"></span>
        </button>
      </form>

      <style>
        [data-submitting='true'].btn .submit-text { display: none; }
        [data-submitting='true'].btn .loading { display: inline-block; }
        .btn .loading { display: none; }
      </style>

    </div>
  </div>
</div>
{% endblock %}
