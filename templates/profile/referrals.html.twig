{% extends "profile.html.twig" %}

{% block content %}

<div class="form rounded-bottom" style="margin-bottom:24px;">
  <h5>{% trans %}profile.referrals.share.title{% endtrans %}</h5>
  <div class="form-group">
    <label class="control-label">{% trans %}profile.referrals.share.label{% endtrans %}</label>
    <div class="input-group" data-toggle="copy" data-clipboard-text="{{ referral_link }}">
      <span class="input-group-addon bg-primary"><i class="fa fa-link fa-rotate-90 text-white"></i></span>
      <input type="text" class="form-control" value="{{ referral_link }}" readonly>
    </div>
    <div class="d-flex justify-content-end mt-3">
      <button id="referral-copy-button" type="button" class="btn btn-primary" data-toggle="copy" data-clipboard-text="{{ referral_link }}">
        <i class="fa fa-copy mr-2"></i>
        {% trans %}profile.referrals.share.copy{% endtrans %}
      </button>
    </div>
  </div>
</div>

<div class="panel panel-default" style="margin-bottom:24px;">
  <div class="panel-body">
    <div style="display:flex;justify-content:space-between;align-items:center;">
      <div>
        <h4 style="margin:0;">
          {% if level %}
            {{ ('referral.level.' ~ level.name)|trans({}, 'emails') }}
          {% else %}
            {% trans %}profile.referrals.no_level_yet{% endtrans %}
          {% endif %}
        </h4>
        <p class="text-muted" style="margin:0;">
          {% trans with { '%count%': successful_referral_count } %}profile.referrals.successful_count{% endtrans %}
        </p>
      </div>
      {% if next_level %}
      <p class="text-muted text-right" style="margin:0;">
        {% trans with { '%count%': next_level.minReferralCount - successful_referral_count, '%level%': ('referral.level.' ~ next_level.name)|trans({}, 'emails') } %}profile.referrals.next_level{% endtrans %}
      </p>
      {% endif %}
    </div>
  </div>
</div>

{% if referrals.totalItemCount > 0 %}
<table class="table">
  <thead>
    <tr>
      <th>{% trans %}profile.referrals.column.friend{% endtrans %}</th>
      <th>{% trans %}referral.column.status{% endtrans %}</th>
      <th class="text-right">{% trans %}referral.column.created_at{% endtrans %}</th>
    </tr>
  </thead>
  <tbody>
    {% for referral in referrals %}
    <tr>
      <td>
        {{ referral.referred_first_name }}
        <span class="text-muted">{{ referral.referred_masked_email }}</span>
      </td>
      <td>
        <span class="label label-{{ referral.status == 'completed' ? 'success' : (referral.status == 'expired' ? 'default' : 'info') }}">
          {{ ('referral.status.' ~ referral.status)|trans }}
        </span>
      </td>
      <td class="text-right">{{ referral.created_at|ago }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<nav class="text-center">
  {{ knp_pagination_render(referrals) }}
</nav>
{% else %}
<div class="alert alert-info">{% trans %}profile.referrals.none_yet{% endtrans %}</div>
{% endif %}

{% endblock %}

{% block scripts %}
  {{ encore_entry_script_tags('common') }}

  <script>
    const referralClipboard = new ClipboardJS('[data-toggle="copy"]');

    referralClipboard.on('success', function(e) {
      var el = document.getElementById('referral-copy-button');
      var iconClass = el.childNodes[1].className;
      var text = el.childNodes[2].nodeValue;

      el.childNodes[1].className = 'fa fa-check mr-2';
      el.childNodes[2].nodeValue = "{{ 'profile.referrals.share.copied'|trans }}";

      setTimeout(function () {
        el.childNodes[1].className = iconClass;
        el.childNodes[2].nodeValue = text;
      }, 1000);
    });
  </script>
{% endblock %}
