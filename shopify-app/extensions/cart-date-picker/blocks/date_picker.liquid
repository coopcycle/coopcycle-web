{%- comment -%}
  Read from `app`, not `shop`: tenant_url is an app-data metafield owned by this
  app's own installation. A shop-owned metafield would need a write scope that
  no longer exists, so this is the only variant the app can actually write.
{%- endcomment -%}
{% assign tenant_url = app.metafields.coopcycle.tenant_url.value | default: block.settings.tenant_url %}
<div
  id="coopcycle-date-picker"
  data-tenant-url="{{ tenant_url | escape }}"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-date-label="{{ block.settings.slot_label | escape }}"
  data-unavailable-message="{{ 'date_picker.unavailable' | t | escape }}"
  data-placeholder-label="{{ 'date_picker.placeholder' | t | escape }}"
  style="display:none"
>
  <p class="coopcycle-loading">Loading delivery slots…</p>
</div>

{{ 'coopcycle-date-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coopcycle-date-picker.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CoopCycle Date Picker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "tenant_url",
      "label": "CoopCycle tenant URL",
      "info": "Base URL of your CoopCycle instance, e.g. https://demo.coopcycle.org"
    },
    {
      "type": "text",
      "id": "slot_label",
      "label": "Delivery slot field label",
      "default": "Delivery slot"
    }
  ]
}
{% endschema %}
