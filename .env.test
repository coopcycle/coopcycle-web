APP_ENV=test
BUSINESS_ACCOUNT_ENABLED=1
COOPCYCLE_MAIL_URL=smtp://smtp:25
COOPCYCLE_MAIL_TRANSPORT=smtp
COOPCYCLE_MAIL_SENDER_ADDRESS=hello@coopcycle.dev
COOPCYCLE_MAIL_SENDER_NAME=CoopCycle
COOPCYCLE_COUNTRY=fr
COOPCYCLE_LOCALE=fr
COOPCYCLE_REGION=fr
FORCE_STRIPE=0
STRIPE_CONNECT_REQUIRED=1
STRIPE_PUBLISHABLE_KEY=key
STRIPE_SECRET_KEY=secret_key
STRIPE_CONNECT_CLIENT_ID=client_id
INSEE_API_KEY=
INSEE_API_SECRET=
INSEE_PORTAIL_API_KEY=key
COOPCYCLE_AUTOCOMPLETE_ADAPTER=geocode-earth
GEOCODE_EARTH_API_KEY=YOUR_API_KEY
COOPCYCLE_GEOCODER_AUTOCONF_ENABLED=0

###> snc/redis-bundle ###
COOPCYCLE_REDIS_DSN=redis://redis:6379/1
###< snc/redis-bundle ###

###> symfony/messenger ###
# Use Redis for Behat and e2e tests
# PHPUnit tests override this with in-memory:// in phpunit.xml.dist
MESSENGER_TRANSPORT_DSN=redis://redis:6379/coopcycle_test:messages?dbindex=1
###< symfony/messenger ###

###> Shopify ###
# The gateway->tenant shared secret. The compliance endpoint rejects everything
# when this is empty, so the Behat scenarios need a deterministic non-empty
# value here — .env.dist ships it empty, as a real one is per-installation.
SHOPIFY_GATEWAY_SECRET=behat_shopify_gateway_secret
###< Shopify ###
