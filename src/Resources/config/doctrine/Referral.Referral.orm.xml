<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
  <entity repository-class="AppBundle\Entity\Referral\ReferralRepository" name="AppBundle\Entity\Referral\Referral" table="referral">
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="status" type="string" column="status" length="16">
      <options>
        <option name="default">pending</option>
      </options>
    </field>
    <field name="createdAt" type="datetime" column="created_at">
      <gedmo:timestampable on="create"/>
    </field>
    <field name="completedAt" type="datetime" column="completed_at" nullable="true"/>
    <many-to-one field="referrer" target-entity="AppBundle\Entity\Sylius\Customer">
      <join-columns>
        <join-column name="referrer_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
    <one-to-one field="referred" target-entity="AppBundle\Entity\Sylius\Customer">
      <join-columns>
        <join-column name="referred_id" referenced-column-name="id" nullable="false" unique="true" on-delete="CASCADE"/>
      </join-columns>
    </one-to-one>
    <many-to-one field="triggeringOrder" target-entity="Sylius\Component\Order\Model\OrderInterface">
      <join-columns>
        <join-column name="triggering_order_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="referrerRewardCoupon" target-entity="AppBundle\Entity\Sylius\PromotionCoupon">
      <join-columns>
        <join-column name="referrer_reward_coupon_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="referredWelcomeCoupon" target-entity="AppBundle\Entity\Sylius\PromotionCoupon">
      <join-columns>
        <join-column name="referred_welcome_coupon_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
