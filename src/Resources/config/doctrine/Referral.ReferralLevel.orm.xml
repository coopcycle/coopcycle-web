<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
  <entity name="AppBundle\Entity\Referral\ReferralLevel" table="referral_level">
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="name" type="string" column="name" length="64"/>
    <field name="position" type="integer" column="position">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="minReferralCount" type="integer" column="min_referral_count"/>
    <field name="rewardType" type="string" column="reward_type" length="32"/>
    <field name="rewardAmount" type="integer" column="reward_amount" nullable="true"/>
    <field name="rewardPercentage" type="float" column="reward_percentage" nullable="true"/>
    <field name="couponValidityDays" type="integer" column="coupon_validity_days">
      <options>
        <option name="default">30</option>
      </options>
    </field>
    <field name="usageLimit" type="integer" column="usage_limit" nullable="true">
      <options>
        <option name="default">1</option>
      </options>
    </field>
    <field name="updatedAt" type="datetime" column="updated_at">
      <gedmo:timestampable on="update"/>
    </field>
  </entity>
</doctrine-mapping>
