<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
  <entity repository-class="AppBundle\Entity\OrderTransferRepository" name="AppBundle\Entity\OrderTransfer" table="order_transfer">
    <unique-constraints>
      <!-- The durable guard against paying a restaurant twice. Stripe's own
           idempotency keys expire after 24h; this does not. -->
      <unique-constraint name="uniq_order_transfer_idempotency" columns="order_id,idempotency_key"/>
      <unique-constraint name="uniq_order_transfer_stripe_id" columns="stripe_transfer_id"/>
    </unique-constraints>
    <indexes>
      <index name="idx_order_transfer_state" columns="state,created_at"/>
      <index name="idx_order_transfer_group" columns="transfer_group"/>
    </indexes>
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="stripeTransferId" type="string" column="stripe_transfer_id" length="255" nullable="true"/>
    <field name="amount" type="integer" column="amount"/>
    <field name="currencyCode" type="string" column="currency_code" length="3"/>
    <field name="sourceTransaction" type="string" column="source_transaction" length="255" nullable="true"/>
    <field name="transferGroup" type="string" column="transfer_group" length="255"/>
    <field name="idempotencyKey" type="string" column="idempotency_key" length="255"/>
    <field name="state" type="string" column="state" length="32"/>
    <field name="reversedAmount" type="integer" column="reversed_amount">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="failureCode" type="string" column="failure_code" length="255" nullable="true"/>
    <field name="createdAt" type="datetime" column="created_at">
      <gedmo:timestampable on="create"/>
    </field>
    <field name="updatedAt" type="datetime" column="updated_at">
      <gedmo:timestampable on="update"/>
    </field>
    <many-to-one field="order" target-entity="Sylius\Component\Order\Model\OrderInterface">
      <join-columns>
        <join-column name="order_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="restaurant" target-entity="AppBundle\Entity\LocalBusiness">
      <join-columns>
        <join-column name="restaurant_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
