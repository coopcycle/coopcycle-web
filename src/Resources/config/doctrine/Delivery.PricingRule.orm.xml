<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="AppBundle\Entity\Delivery\PricingRule" table="pricing_rule">
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="target" type="text" column="target"/>
    <field name="expression" type="text" column="expression"/>
    <field name="price" type="text" column="price"/>
    <field name="position" type="integer" column="position" nullable="true"/>
    <many-to-one field="ruleSet" target-entity="AppBundle\Entity\Delivery\PricingRuleSet" inversed-by="rules">
      <cascade>
        <cascade-persist/>
      </cascade>
      <join-columns>
        <join-column name="rule_set_id" referenced-column-name="id" nullable="false"/>
      </join-columns>
    </many-to-one>
    <field name="matrixRowKey" type="string" column="matrix_row_key" nullable="true"/>
    <field name="matrixColumnKey" type="string" column="matrix_column_key" nullable="true"/>
    <many-to-one field="matrix" target-entity="AppBundle\Entity\Delivery\PricingMatrix" inversed-by="rules">
      <join-columns>
        <join-column name="matrix_id" referenced-column-name="id" nullable="true" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
    <one-to-many field="productOptionValues" target-entity="AppBundle\Entity\Sylius\ProductOptionValue" mapped-by="pricingRule">
      <cascade>
        <cascade-persist/>
      </cascade>
    </one-to-many>
  </entity>
</doctrine-mapping>
