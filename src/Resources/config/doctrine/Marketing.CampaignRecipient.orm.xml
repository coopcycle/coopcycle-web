<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd" xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
  <entity repository-class="AppBundle\Entity\Marketing\CampaignRecipientRepository" name="AppBundle\Entity\Marketing\CampaignRecipient" table="marketing_campaign_recipient">
    <unique-constraints>
      <!-- One row per address per campaign: a retried send must update the
           attempt, not add a second one, or the frequency cap would count a
           retry as another campaign. -->
      <unique-constraint name="uniq_campaign_recipient" columns="campaign_id,email"/>
    </unique-constraints>
    <indexes>
      <!-- What the frequency cap reads. -->
      <index name="idx_campaign_recipient_email_sent_at" columns="email,sent_at"/>
    </indexes>
    <id name="id" type="integer" column="id">
      <generator strategy="IDENTITY"/>
    </id>
    <field name="email" type="string" column="email" length="255"/>
    <field name="status" type="string" column="status" length="16">
      <options>
        <option name="default">pending</option>
      </options>
    </field>
    <field name="messageId" type="string" column="message_id" length="255" nullable="true"/>
    <field name="error" type="string" column="error" length="255" nullable="true"/>
    <field name="sentAt" type="datetime" column="sent_at" nullable="true"/>
    <field name="createdAt" type="datetime" column="created_at">
      <gedmo:timestampable on="create"/>
    </field>
    <many-to-one field="campaign" target-entity="AppBundle\Entity\Marketing\Campaign">
      <join-columns>
        <join-column name="campaign_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="customer" target-entity="AppBundle\Entity\Sylius\Customer">
      <join-columns>
        <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
